const express = require("express");
const cors = require("cors");
const cookieParser = require("cookie-parser");
require("dotenv").config();

const sequelize = require("./config/db");
const AdminAuth = require("./models/AdminAuth/adminAuth"); 
const adminRoutes = require("./routes/AdminAuth/AdminRoutes");
const inquiryRoutes = require("./routes/Inquiry/inquiryRoutes");

const app = express();

app.use(express.json());
app.use(cookieParser());

app.use(
  cors({
    origin: [
      "http://localhost:5173",
      "http://localhost:5174",
      "https://real-estate-alpha-sand-38.vercel.app"
    ], 
    credentials: true,
  })
);

// 🔥 CRITICAL FIX FOR LIVE cPANEL SUBFOLDER ROUTING
// This strips the folder name prefix out so Express can match your routes below
// app.use((req, res, next) => {
//   const prefix = "/connectyou-api";
//   if (req.url.startsWith(prefix)) {
//     req.url = req.url.substring(prefix.length);
//   }
//   // Sanity check: Ensure the path always retains its leading slash
//   if (!req.url.startsWith("/")) {
//     req.url = "/" + req.url;
//   }
//   next();
// });

// 📌 MOUNT ROUTES 
app.use("/api/auth", adminRoutes);
app.use("/api/inquiry", inquiryRoutes);

// Fallback test route to confirm subfolder stripping works
app.get("/", (req, res) => {
  res.send("ConnectYou RealEstate Backend is running flawlessly!");
});

const PORT = process.env.PORT || 8006;

sequelize
  .sync({ alter: true }) 
  .then(() => {
    console.log("🚀 Database connected & synced successfully!");
    app.listen(PORT, () => {
      console.log(`📡 Server running on port ${PORT}`);
    });
  })
  .catch((error) => {
    console.error("❌ Database connection failed:", error.message);
  });

module.exports = app;